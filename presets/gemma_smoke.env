# Smoke-test preset for run_gemma_non_torchtitan_xpu.sh
# One short step on the plain (non-FSDP) trainer. Use to verify the launch
# path, dataset access and device binding before committing to a real run.
#
#   ./run_gemma_non_torchtitan_xpu.sh single --dry-run
#
# Sourced by the wrapper with SCRIPT_DIR already set. Every assignment uses
# ":=" so a value already present in the environment always wins.

: "${TRAIN_ENTRY:=${SCRIPT_DIR}/non_torchtitan_gemma_train.py}"
: "${LOG_DIR_TAG:=gemma_non_torchtitan_xpu}"

: "${TRAIN_STEPS:=1}"
: "${SEQ_LEN:=16384}"
: "${BATCH_SIZE:=1}"
: "${MICRO_BATCH_SIZE:=1}"
: "${LOGIT_CHUNK_SIZE:=256}"
: "${DATASET_MAX_SAMPLES:=64}"
: "${DISABLE_TIME_CHECKPOINT:=0}"
