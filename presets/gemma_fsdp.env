# Production FSDP preset for run_gemma_non_torchtitan_xpu.sh
# Full-length pg19+multi_news run on the FSDP2 trainer.
#
#   GEMMA_PRESET=fsdp ./run_gemma_non_torchtitan_xpu.sh multi "$hostfile"
#
# Sourced by the wrapper with SCRIPT_DIR already set. Every assignment uses
# ":=" so a value already present in the environment always wins.

: "${TRAIN_ENTRY:=${SCRIPT_DIR}/non_torchtitan_gemma_train_FSDP.py}"
: "${LOG_DIR_TAG:=gemma_FSDP_pg19_multinews_bsz4_steps158000_seq16384}"

: "${TRAIN_STEPS:=158000}"
: "${SEQ_LEN:=16384}"
: "${BATCH_SIZE:=4}"
: "${MICRO_BATCH_SIZE:=1}"
: "${LOGIT_CHUNK_SIZE:=256}"
: "${DATASET_MAX_SAMPLES:=256}"
: "${DISABLE_TIME_CHECKPOINT:=1}"
